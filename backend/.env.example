# Server
NODE_ENV=development
PORT=8000

# MongoDB (local dev). With docker-compose, use the mongo service name, e.g.:
# MONGODB_URL=mongodb://mongo:27017/lexora
MONGODB_URL=mongodb://localhost:27017/lexora

# Redis (local dev). With docker-compose, use hostname "redis" (see docker-compose.yml).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@lexora.com

# OTP
OTP_EXPIRY_SECONDS=300

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Object Storage (S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
STORAGE_BUCKET=lexora-pictures
STORAGE_PICTURES_BUCKET=lexora-pictures
STORAGE_LISTENING_BUCKET=lexora-listening-audio
STORAGE_SPEAKING_BUCKET=lexora-speaking-audio
STORAGE_REGION=us-east-1
STORAGE_COURSE_BUCKET=lexora-course-videos


# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
